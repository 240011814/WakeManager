{
    // USB-JTAG 源码级调试（ESP32-S3，本机路径配置，按 .gitignore 不入库）
    //
    // request 必须是 "attach"：launch 模式下适配器会自己 spawn 一个 "gdbserver"
    // 当被调试端（ESP32 上不存在该程序 → spawn gdbserver ENOENT）；attach 模式
    // 直接连 OpenOCD 的 gdb 端口 3333，OpenOCD 由 runOpenOCD: true 自动拉起
    // （配置取 .vscode/settings.json 的 idf.openOcdConfigs=board/esp32s3-builtin.cfg）。
    //
    // 注意：若之前有残留 OpenOCD（手动开的或上次失败会话的），先 pkill -f openocd，
    // 否则端口 3333 被占、新实例起不来。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "wol-rs: USB-JTAG 调试（ESP32-S3）",
            "type": "gdbtarget",
            "request": "attach",
            "gdb": "/Users/hyy/.espressif/tools/xtensa-esp-elf-gdb/17.1_20260402/xtensa-esp-elf-gdb/bin/xtensa-esp32s3-elf-gdb",
            "program": "${workspaceFolder}/target/xtensa-esp32s3-espidf/debug/wol-rs",
            "cwd": "${workspaceFolder}",
            "runOpenOCD": true,
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "target remote localhost:3333"
                ]
            }
        }
    ]
}
