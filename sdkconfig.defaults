# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads
# that allocate large stack variables; or better yet - use
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# --- WakeManager: 编译器优化级别 -Os ---
# 该设定历史上只存在于 out/sdkconfig（menuconfig 改的），清缓存全量重建时会
# 悄悄回落默认 -Og（固件大 ~115KB、无收益）——2026-10 固化进 defaults。
# 现代 choice 名为 COMPILER_OPTIMIZATION_SIZE（-Os），旧符号 LEVEL_RELEASE
# 由 kconfig 自动镜像，无需手写。
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- WakeManager: BLE 配网传输层：NimBLE host ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- WakeManager: protocomm security version 1（X25519 + PoP + AES-CTR）---
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# --- WakeManager: 日志时间戳：系统本地时间（SNTP 校时前显示 epoch）---
# 日志时间戳带日期：26-10-13 10:50:09.111（SNTP 校时前显示 70-01-01 00:00:xx）
# SYSTEM_FULL 依赖 LOG_VERSION_2（v1 只提供 HH:MM:SS.mmm）
CONFIG_LOG_VERSION_2=y
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM_FULL=y

# --- WakeManager: 8MB PSRAM（立创 ESP32S3R8N8：octal PSRAM）---
# 大分配（JSON/OTA 下载缓冲等）落 PSRAM，缓解内部 RAM 压力（std::thread 的
# 任务栈固定从内部分配，见 CLAUDE.md 开发经验）。
# IGNORE_NOTFOUND：Wokwi 模拟无 PSRAM 时不 panic 只降级（Wi-Fi/LWIP 缓冲退回
# 无 PSRAM 默认值）；真机有 PSRAM 时正常启用。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y

# --- WakeManager: Wi-Fi CSI 近场人体感知（csi_presence）---
# CSI 每收到一帧（AP beacon/下行帧）回调一次；额外占用约
# CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM KB RAM
CONFIG_ESP_WIFI_CSI_ENABLED=y
# 以下配置照抄 ESPectre 的 sdkconfig.defaults（感知硬件配置同款）：
# - 关 A-MPDU TX：否则 esp_wifi_config_80211_tx_rate 的速率钉定被驱动忽略
#   （回退自动速率）；- 关 A-MPDU RX：下行帧逐个出 CSI、粒度一致；
# - FreeRTOS 1000Hz tick：10ms（100pps）探测节拍精度（默认 100Hz 只能以
#   10ms 粒度调度）。
# （ESPectre 还关断连省电 STA_DISCONNECTED_PM_ENABLE——本项目 BLE 配网启用
#   esp_coex 软共存，该符号被其 select 强制 y，无法在 sdkconfig 关闭；
#   连接后感知依赖运行期 WIFI_PS_NONE，不受影响。）
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_FREERTOS_HZ=1000

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="$ENV{PROJECT_DIR}/partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# Flash 四线 QIO（提速参考：代码/数据加载约快一倍；烧录仍走 DIO，bootloader
# 自升级四线。若开机不启动=flash 不支持四线，改回 CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# 后串口重烧即可恢复）
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
