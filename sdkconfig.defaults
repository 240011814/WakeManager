# WakeManager provisioning defaults (ESP-IDF v6.x)
# Applied when sdkconfig is generated. Existing sdkconfig values take priority.

# --- BLE provisioning transport: NimBLE host ---
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# --- protocomm security version 1 (X25519 + PoP + AES-CTR) ---
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

# --- Partition table: BT + provisioning binary is larger than the
#     default single-app partition, so use a custom table ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- Logging: show the system (local) wall-clock time instead of the
#     default "milliseconds since boot" (I (12345)). The clock is set by the
#     SNTP sync after Wi-Fi connects; before that it reads 00:00:00 (epoch). ---
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y