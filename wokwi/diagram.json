{
    "version": 1,
    "author": "wakemanager",
    "editor": "wokwi",
    "parts": [
        {
            "type": "board-esp32-s3-devkitc-1",
            "id": "esp",
            "top": 0,
            "left": 0,
            "attrs": { "flashSize": "8" }
        },
        {
            "type": "wokwi-led",
            "id": "led1",
            "top": -80,
            "left": 140,
            "attrs": { "color": "red" }
        },
        {
            "type": "wokwi-resistor",
            "id": "r1",
            "top": -20,
            "left": 160,
            "attrs": { "value": "220" }
        }
    ],
    "connections": [
        [ "esp:TX", "$serialMonitor:RX", "", [] ],
        [ "esp:RX", "$serialMonitor:TX", "", [] ],
        [ "esp:3V3.1", "led1:A", "red", [] ],
        [ "led1:C", "r1:1", "black", [] ],
        [ "r1:2", "esp:48", "green", [] ]
    ],
    "serialMonitor": {
        "display": "terminal",
        "convertEol": true
    }
}
